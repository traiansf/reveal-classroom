# Instance settings for the user-level installation (deploy/user/install.sh).
# Copy to deploy/instance.env in the deploy directory you bundle (reveal-classroom bundle --deploy DIR).
# This file travels inside the bundle: never put the presenter password here.

# Name of the installation: ~/.local/share/$APP_NAME, ~/.config/$APP_NAME, $APP_NAME.service.
APP_NAME=reveal-classroom
# Name of the systemd timer/service pair that pulls updates (default: $APP_NAME-update).
UPDATE_UNIT=
# Loopback port the reverse proxy forwards to.
PORT=3000
# URL prefix when the proxy serves the presentations below a path, e.g. /slides
# (the proxy must keep the prefix in the requests it forwards). Empty for a whole host.
BASE_PATH=
# Automatic updates: a public release directory containing latest.json and $BUNDLE_NAME,
# e.g. https://github.com/OWNER/REPO/releases/download/TAG. Leave empty to update by hand.
RELEASE_URL=
BUNDLE_NAME=reveal-classroom.tar.gz
# Private Node.js runtime (downloaded once into ~/.local/share/$APP_NAME/runtime).
# Set USE_SYSTEM_NODE=1 to use the node (>= 22) found on PATH instead.
NODE_VERSION=24.21.0
NODE_SHA256_LINUX_X64=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
NODE_SHA256_LINUX_ARM64=
USE_SYSTEM_NODE=0
