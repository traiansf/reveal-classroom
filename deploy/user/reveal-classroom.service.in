# Generated by deploy/user/install.sh from reveal-classroom.service.in; edits are overwritten.
[Unit]
Description=reveal-classroom presentation service (@APP_NAME@)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/@APP_NAME@/app
Environment=HOST=127.0.0.1 PORT=@PORT@ BASE_PATH=@BASE_PATH@
# Holds PRESENTATION_PASSWORD; settings here override the line above.
EnvironmentFile=%h/.config/@APP_NAME@/environment
ExecStart=@NODE@ %h/.local/share/@APP_NAME@/app/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
