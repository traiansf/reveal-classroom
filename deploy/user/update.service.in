# Generated by deploy/user/install.sh from update.service.in; edits are overwritten.
[Unit]
Description=Download and install the latest @APP_NAME@ bundle

[Service]
Type=oneshot
Environment=APP_NAME=@APP_NAME@ RELEASE_URL=@RELEASE_URL@ BUNDLE_NAME=@BUNDLE_NAME@
Environment=PATH=%h/.local/share/@APP_NAME@/runtime/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash %h/.local/share/@APP_NAME@/update.sh
TimeoutStartSec=10min
NoNewPrivileges=true
UMask=0077
