# Generated by deploy/user/install.sh from update.timer.in; edits are overwritten.
# Stop it during a lecture to avoid restarts: systemctl --user stop @UPDATE_UNIT@.timer
[Unit]
Description=Check for @APP_NAME@ updates every minute

[Timer]
OnBootSec=1min
OnUnitInactiveSec=1min
AccuracySec=5s
Unit=@UPDATE_UNIT@.service

[Install]
WantedBy=timers.target
